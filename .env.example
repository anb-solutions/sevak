# Copy to .env.local for local overrides. Never commit real values.
# Without DATABASE_URL the app uses an in-memory PGlite database with fake demo data.
DATABASE_URL=
# Where links in emails point. Without it, the address the browser used.
APP_URL=http://localhost:3000
# "log" prints emails (and sign-in codes) to the server log; "resend" sends them.
EMAIL_MODE=log
RESEND_API_KEY=
# The sender. Default: notify@staging.sevak.theanbgroup.com, or notify@sevak.theanbgroup.com in production.
EMAIL_FROM=
# Sevak staff, who can verify organizations: emails, separated by commas.
SEVAK_PLATFORM_ADMINS=
# "staging" or "production" (set by the deploy). Only staging gets demo data from `pnpm db:seed`.
SEVAK_ENV=
